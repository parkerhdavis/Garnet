{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Garnet",
	"version": "0.3.0",
	"identifier": "com.parkerhdavis.garnet",
	"build": {
		"beforeDevCommand": {
			"script": "bun run dev",
			"cwd": ".."
		},
		"devUrl": "http://localhost:5173",
		"frontendDist": "../frontend/dist"
	},
	"app": {
		"windows": [
			{
				"title": "Garnet",
				"width": 1280,
				"height": 840,
				"minWidth": 1000,
				"minHeight": 700,
				"resizable": true,
				"dragDropEnabled": true,
				"visible": false,
				"backgroundColor": "#0c0b09"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$DOWNLOAD/**",
					"$DOCUMENT/**",
					"$DESKTOP/**",
					"$HOME/**",
					"$HOME/.cache/garnet/**",
					"$HOME/.config/garnet/**",
					"$HOME/.local/share/garnet/**"
				]
			},
			"capabilities": [
				{
					"identifier": "main-capability",
					"windows": ["*"],
					"permissions": [
						"dialog:allow-open",
						"dialog:allow-save",
						"fs:allow-read-text-file",
						"fs:allow-write-text-file",
						"fs:allow-read-file",
						"fs:allow-write-file",
						"fs:allow-exists",
						"fs:allow-read-dir",
						"fs:allow-mkdir",
						"fs:allow-copy-file",
						{
							"identifier": "fs:scope",
							"allow": [
								"$DOWNLOAD/**",
								"$DOCUMENT/**",
								"$DESKTOP/**",
								"$HOME/**"
							]
						},
						"core:path:allow-resolve-directory",
						"core:event:allow-listen",
						"core:webview:allow-set-webview-zoom",
						"opener:allow-open-url",
						{
							"identifier": "opener:allow-open-path",
							"allow": [{ "path": "**" }]
						},
						{
							"identifier": "opener:allow-reveal-item-in-dir",
							"allow": [{ "path": "**" }]
						}
					]
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"macOS": {
			"hardenedRuntime": true,
			"entitlements": "entitlements.plist"
		},
		"licenseFile": "../../../LICENSE.md",
		"fileAssociations": [
			{
				"ext": ["png", "jpg", "jpeg", "gif", "bmp", "tif", "tiff", "webp", "avif", "svg", "ico"],
				"name": "Image",
				"description": "Image",
				"role": "Viewer",
				"mimeType": "image/png,image/jpeg,image/gif,image/bmp,image/tiff,image/webp,image/avif,image/svg+xml,image/x-icon"
			},
			{
				"ext": ["mp4", "mov", "mkv", "avi", "webm", "m4v", "wmv"],
				"name": "Video",
				"description": "Video",
				"role": "Viewer",
				"mimeType": "video/mp4,video/quicktime,video/x-matroska,video/x-msvideo,video/webm,video/x-ms-wmv"
			},
			{
				"ext": ["mp3", "wav", "flac", "ogg", "aiff", "m4a", "opus"],
				"name": "Audio",
				"description": "Audio",
				"role": "Viewer",
				"mimeType": "audio/mpeg,audio/wav,audio/flac,audio/ogg,audio/aiff,audio/mp4,audio/opus"
			},
			{
				"ext": ["gltf", "glb", "obj", "stl", "ply", "fbx", "usd", "usda", "usdc", "usdz", "blend"],
				"name": "3D Model",
				"description": "3D model",
				"role": "Viewer"
			}
		],
		"icon": [
			"../../../resources/icons/32x32.png",
			"../../../resources/icons/128x128.png",
			"../../../resources/icons/128x128@2x.png",
			"../../../resources/icons/512x512.png",
			"../../../resources/icons/icon.icns",
			"../../../resources/icons/icon.ico"
		]
	}
}
